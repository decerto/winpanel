# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Runtime data — never commit
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.dpapi
*.pfx
*.pem
*.key

# Local development sandbox: whatever WINPANEL_ROOT / WINPANEL_SITES_ROOT are
# pointed at when running the agent by hand. Holds a real vault key, the panel
# database, and a junction to the installed Git.
.devroot/
.devsites/

# Secrets
.env
.env.*
!.env.example

# Logs
logs/
!apps/agent/src/logs/
!apps/agent/src/logs/**
*.log
npm-debug.log*
pnpm-debug.log*

# Downloaded components (fetched at runtime, never committed)
bin/caddy.exe
bin/stalwart.exe
bin/WinSW*.exe
vendor/

# Installer output
installer/output/

# Installer build artefacts. Rebuilt by `pnpm bundle`, and large: a staged
# Node runtime plus the agent's resolved dependencies.
packages/installer/staging/
packages/installer/.cache/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
