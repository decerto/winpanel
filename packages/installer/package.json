{
  "name": "@winpanel/installer",
  "version": "1.13.5",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "description": "Builds the self-contained Windows installer.",
  "scripts": {
    "bundle": "node --experimental-strip-types scripts/build-bundle.ts",
    "installer": "node --experimental-strip-types scripts/build-installer.ts",
    "release": "pnpm bundle && pnpm installer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
