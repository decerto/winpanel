{
  "id": "minecraft-java-vanilla",
  "provider": "minecraft-java",
  "name": "Minecraft Java Edition",
  "description": "Vanilla Minecraft Java server for Windows.",
  "status": "ready",
  "genre": "Sandbox",
  "art": "forest",
  "artUrl": "https://www.minecraft.net/content/dam/minecraftnet/games/minecraft/game-characters/MC-About_Key-Art_Build_Amazing_Things_600x800.png",
  "requiresEula": true,
  "steamRequiresOwnership": false,
  "executable": "server.jar",
  "runtime": "java",
  "launchArgs": ["-jar", "{installPath}\\server.jar", "nogui"],
  "workingDirectory": "data",
  "console": "none",
  "configFile": "server.properties",
  "seedFiles": [
    {
      "path": "eula.txt",
      "format": "text",
      "mode": "merge",
      "content": "# Accepted through WinPanel\neula=true"
    },
    {
      "path": "server.properties",
      "format": "properties",
      "mode": "merge",
      "values": { "server-port": "{port:game}" }
    }
  ],
  "ports": [
    { "name": "game", "protocol": "tcp", "purpose": "game", "visibility": "public", "port": 25565 }
  ]
}
