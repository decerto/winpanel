{
  "id": "zomboid-dedicated",
  "provider": "steam",
  "name": "Project Zomboid Dedicated Server",
  "description": "Project Zomboid dedicated server for Windows, downloaded anonymously through SteamCMD with the bundled JRE and a panel-managed profile.",
  "status": "ready",
  "genre": "Survival",
  "art": "steel",
  "requiresEula": true,
  "steamRequiresOwnership": false,
  "steamAppId": 380870,
  "steamArtAppId": 108600,
  "executable": "StartServer64.bat",
  "launchExecutable": "jre64/bin/java.exe",
  "launchArgs": [
    "-Djava.awt.headless=true",
    "-Dzomboid.steam=1",
    "-Dzomboid.znetlog=1",
    "-XX:+UseZGC",
    "-XX:-CreateCoredumpOnCrash",
    "-XX:-OmitStackTraceInFastThrow",
    "-Xms{heapMb}m",
    "-Xmx{heapMb}m",
    "-Djava.library.path=natives/;natives/win64/;.",
    "-cp", "{classpath}",
    "zombie.network.GameServer",
    "-servername", "{slug}",
    "-statistic", "0"
  ],
  "console": "none",
  "dataDirectory": "zomboid-profile",
  "configFile": "{slug}.ini",
  "ports": [
    { "name": "game", "protocol": "udp", "purpose": "game", "visibility": "public", "port": 16261 },
    { "name": "direct", "protocol": "udp", "purpose": "query", "visibility": "public", "port": 16262 }
  ]
}
