{
  "name": "winpanel",
  "version": "1.0.0",
  "private": true,
  "description": "Server and website control panel for Windows Server 2025",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "installer": "pnpm build && pnpm -C packages/installer release"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
