{
  "name": "winpanel",
  "version": "1.12.1",
  "private": true,
  "description": "Free control panel for hosting websites, Node.js apps and game servers on Windows Server 2022/2025 and Windows 11 Home/Pro, without IIS",
  "keywords": [
    "windows hosting panel",
    "windows server control panel",
    "plesk alternative",
    "cpanel alternative",
    "iis alternative",
    "nodejs hosting",
    "wordpress hosting",
    "game server hosting",
    "game server control panel",
    "minecraft server hosting",
    "steam dedicated server",
    "windows game server",
    "self-hosted"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "installer": "pnpm build && pnpm -C packages/installer release"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
